{
  "Parameters": {
    "Ray": {
      "ServerKit": {
        "Resources": {
          "AzureStorage": {
            "AspireResourceName": "ray-storage-azure",
            "AspireTableStorageResourceName": "ray-storage-azure-table",
            "AspireBlobStorageResourceName": "ray-storage-azure-blob"
          },
          "MongoDb": {
            "AspireResourceName": "ray-storage-mongodb"
          }
        },
        "Extensions": {
          "KeyCloak": {
            "AspireResourceName": "ray-keycloak-service",
            "AspireIdentityApiName": "ray-identity-api",
            "RealmName": "ray-keycloak-realm",
            "Clients": {
              "UserClient": {
                "Id": "ray-keycloak-user-client"
              },
              "UserAdministrationClient": {
                "Id": "ray-keycloak-user-administration-client"                
              }               
            },
            "KeyCloakInternalAdminClient": {
              "Id": "admin-cli",
              "CacheLifetimePercentage": 0.8,
              "DefaultExpirationSeconds": 300,
              "ClockSkew": 5000
            }
          }
        },
        "Globals": {
          "Orleans": {
            "ClusterId": "ray-orleans-cluster",
            "ClusteringTableName": "ray-orleans-clustering-table"
          }
        },
        "Apps": {
          "User": {
            "UserApi": {
              "AspireResourceName": "ray-user-api"
            },
            "OrleansSilo": {
              "AspireResourceName": "ray-user-silo",
              "UserIdentityDatabaseName": "ray-user-identity-db",
              "UserIdentityGrainCollectionName": "user-identity-grains",
              "UserIdentityGrainStateName": "user-state"
            }
          }
        }
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Aspire.Hosting.Dcp": "Warning"
      }
    }
  }
}
